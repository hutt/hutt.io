              </g>
            </svg>
          </span>
          {{ site.kontakt.signal_username }}
        </a>
        <a href="https://matrix.to/#/{{ site.kontakt.matrix }}" title="Matrix" class="contact-link" target="_blank" rel="noopener" style="flex: 1;">
          <span class="contact-link-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 520 520" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
